---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Introduccion from '../components/Introduccion.astro';
import Historia from '../components/Historia.astro';
import MenuDestacado from '../components/MenuDestacado.astro';
import GaleriaPreview from '../components/GaleriaPreview.astro';
import Visitenos from '../components/Visitenos.astro';

const placeholder = '/images/truchas-san-ignacio-main.jpg';

const platillosDestacados = [
  { nombre: 'Trucha entera frita', descripcion: 'Preparada al momento, recién salida del estanque.', imageSrc: '/images/menu/menu1.jpg' },
  { nombre: 'Ceviche de Pescado', descripcion: 'Delicioso ceviche de pescado fresco.', imageSrc: '/images/menu/menu3.jpg' },
  { nombre: 'Lomo a la plancha de la Casa', descripcion: 'Un sabor distinto, preparado con técnica tradicional.', imageSrc: '/images/menu/menu6.jpg' },
];

const imagenesGaleria = [
  { src: '/images/lugar/lugar1.jpg', alt: 'Entrada principal al restaurante' },
  { src: '/images/lugar/lugar2.jpg', alt: 'Estanques de pesca' },
  { src: '/images/lugar/lugar3.jpg', alt: 'Estanques de pesca' },
  { src: '/images/lugar/lugar4.jpg', alt: 'Zonas verdes del restaurante' },
];
---

<Layout title="Inicio" description="Restaurante de pesca de trucha en el Valle de Orosi, Cartago">
  <Hero
    imageSrc={placeholder}
    imageAlt="Lago principal de Truchas San Ignacio"
  />

  <Introduccion
    imageSrc={placeholder}
    imageAlt="Lago principal de Truchas San Ignacio"
  />

  <Historia />

  <MenuDestacado platillos={platillosDestacados} />

  <GaleriaPreview imagenes={imagenesGaleria} />

  <Visitenos />
</Layout>
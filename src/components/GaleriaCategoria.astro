---
interface Props {
  nombre: string;
  imagenes: { src: string; alt: string }[];
  offset: number;
}

const { nombre, imagenes, offset } = Astro.props;
const trackId = `track-${offset}`;
---

<div class="mb-16">
  <h2 class="font-serif text-3xl text-forest-800 mb-6 px-1">{nombre}</h2>

  <div class="relative group/row">
    <button
      class="galeria-prev hidden md:flex absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 z-10 w-11 h-11 items-center justify-center rounded-full bg-white shadow-lg text-forest-800 opacity-0 group-hover/row:opacity-100 transition-opacity hover:bg-forest-50"
      data-target={trackId}
      aria-label="Anterior"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <div id={trackId} class="galeria-track flex gap-4 overflow-x-auto pb-4 px-1 scrollbar-hide scroll-smooth">
      {imagenes.map((imagen, i) => (
        <button
          class="lightbox-trigger group shrink-0 rounded-lg overflow-hidden shadow-md w-72 h-72"
          data-index={offset + i}
        >
          <img
            src={imagen.src}
            alt={imagen.alt}
            draggable="false"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
            onerror="this.onerror=null; this.src='/images/galeria/test.jpg';"
          />
        </button>
      ))}
    </div>

    <button
      class="galeria-next hidden md:flex absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 z-10 w-11 h-11 items-center justify-center rounded-full bg-white shadow-lg text-forest-800 opacity-0 group-hover/row:opacity-100 transition-opacity hover:bg-forest-50"
      data-target={trackId}
      aria-label="Siguiente"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</div>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
</style>
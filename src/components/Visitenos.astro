---
const whatsappNumber = '50625333000';
const whatsappMessage = encodeURIComponent('Hola, quisiera hacer una consulta sobre Truchas San Ignacio.');
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<section class="py-24 px-6 bg-forest-900">
  <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center">
    <div>
      <h2 class="font-serif text-4xl text-stone-50 mb-6">Visítenos</h2>

      <div class="space-y-4 font-sans text-stone-100">
        <div>
          <p class="text-sm uppercase tracking-wide text-forest-400 mb-1">Horario</p>
          <p>Sábados, domingos y feriados, 10:00 a.m. a 5:00 p.m.</p>
        </div>

        <div>
          <p class="text-sm uppercase tracking-wide text-forest-400 mb-1">Grupos entre semana</p>
          <p>Grupos de 20 personas o más pueden coordinar apertura entre semana con 2 días de anticipación.</p>
        </div>

        <div>
          <p class="text-sm uppercase tracking-wide text-forest-400 mb-1">Ubicación</p>
          <p>Valle de Orosi, Cartago, a 3 km de la iglesia colonial.</p>
        </div>
      </div>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block mt-8 bg-forest-600 hover:bg-forest-400 text-white font-sans text-sm uppercase tracking-wide px-8 py-3 rounded transition-colors"
      >
        Hacer una consulta por WhatsApp
      </a>
    </div>

    <div class="rounded-lg overflow-hidden shadow-lg h-80 md:h-full">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12962.964958135484!2d-83.86166733126419!3d9.7749867287258!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa1214bfd30bd8d%3A0x636320421179159f!2sTruchas%20San%20Ignacio!5e1!3m2!1ses!2scr!4v1786090286030!5m2!1ses!2scr"
        class="w-full h-full border-0"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>

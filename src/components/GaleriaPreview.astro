---
interface Props {
  imagenes: { src: string; alt: string }[];
}

const { imagenes } = Astro.props;
---

<section class="py-24 px-6 bg-stone-100">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14">
      <h2 class="font-serif text-4xl text-forest-800 mb-3">El lugar</h2>
      <p class="font-sans text-stone-800 max-w-lg mx-auto">Un vistazo al valle, la finca y la experiencia junto al agua.</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 md:grid-rows-2 gap-4 mb-12 md:h-[560px]">
      <div class="col-span-2 aspect-[4/3] md:aspect-auto md:row-span-2 relative group overflow-hidden rounded-lg">
        <img src={imagenes[0].src} alt={imagenes[0].alt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        <div class="absolute inset-0 bg-gradient-to-t from-forest-900/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-5">
          <p class="font-sans text-sm text-stone-50">{imagenes[0].alt}</p>
        </div>
      </div>

      <div class="col-span-2 aspect-[4/3] md:aspect-auto md:row-span-1 relative group overflow-hidden rounded-lg">
        <img src={imagenes[1].src} alt={imagenes[1].alt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        <div class="absolute inset-0 bg-gradient-to-t from-forest-900/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-5">
          <p class="font-sans text-sm text-stone-50">{imagenes[1].alt}</p>
        </div>
      </div>

      <div class="aspect-square md:aspect-auto relative group overflow-hidden rounded-lg">
        <img src={imagenes[2].src} alt={imagenes[2].alt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        <div class="absolute inset-0 bg-gradient-to-t from-forest-900/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
          <p class="font-sans text-xs text-stone-50">{imagenes[2].alt}</p>
        </div>
      </div>

      <div class="aspect-square md:aspect-auto relative group overflow-hidden rounded-lg">
        <img src={imagenes[3].src} alt={imagenes[3].alt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
        <div class="absolute inset-0 bg-gradient-to-t from-forest-900/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
          <p class="font-sans text-xs text-stone-50">{imagenes[3].alt}</p>
        </div>
      </div>
    </div>

    <div class="text-center">
      <a href="/galeria" class="inline-block border border-forest-600 text-forest-800 font-sans text-sm uppercase tracking-wide px-8 py-3 rounded hover:bg-forest-600 hover:text-white transition-colors">Ver galería completa</a>
    </div>
  </div>
</section>
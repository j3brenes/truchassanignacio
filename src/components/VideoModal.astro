---
interface Props {
  youtubeId: string;
}

const { youtubeId } = Astro.props;
---

<button id="video-modal-trigger" class="inline-flex items-center gap-3 mt-6 text-white font-sans text-sm uppercase tracking-wide border border-white/60 rounded-full px-6 py-3 hover:bg-white/10 transition-colors">
  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
    <path d="M8 5v14l11-7z" />
  </svg>
  Conoce el lugar
</button>

<div id="video-modal" class="hidden fixed inset-0 bg-forest-900/95 z-[70] flex items-center justify-center px-6">
  <button id="video-modal-close" class="absolute top-6 right-6 text-stone-50" aria-label="Cerrar video">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <div class="w-[92vw] md:w-[80vw] lg:w-[70vw] max-h-[85vh] aspect-video" id="video-modal-container"></div>
</div>

<script define:vars={{ youtubeId }}>
  const trigger = document.getElementById('video-modal-trigger');
  const modal = document.getElementById('video-modal');
  const closeBtn = document.getElementById('video-modal-close');
  const container = document.getElementById('video-modal-container');

  const openModal = () => {
    container.innerHTML = `<iframe src="https://www.youtube.com/embed/${youtubeId}?autoplay=1" class="w-full h-full rounded" allow="autoplay; encrypted-media" allowfullscreen></iframe>`;
    modal?.classList.remove('hidden');
  };

  const closeModal = () => {
    modal?.classList.add('hidden');
    container.innerHTML = '';
  };

  trigger?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>